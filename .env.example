# Smart Waste Management System Configuration
# Copy this file to .env to customize settings (defaults work out-of-the-box!)

# Google Gemini API Key for multimodal waste analysis and recommendations
# (A default pre-configured key is bundled in the code for instant zero-config testing)
GEMINI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Custom Database Location (Defaults to backend/waste.db)
# WASTE_DB_PATH=backend/waste.db

# Disable background bin drift simulator if desired ("1" = skip, "0" = active)
WASTE_SKIP_SIMULATOR=0
