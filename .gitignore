# Machine Learning generated models & datasets
ml/dataset/*
!ml/dataset/README.md
ml/saved_model/*
!ml/saved_model/.gitkeep

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Secrets & environment configurations
.env
.env.local
!.env.example

